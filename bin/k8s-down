#!/usr/bin/env bash
set -euo pipefail

# Stop workloads while preserving the namespace, Secret and MongoDB PVC.
# This is intentionally non-destructive for local development data.

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PATH="$HOME/.local/bin:$PATH"
NAMESPACE="software-arch-team4"
CLUSTER="${K3D_CLUSTER:-dev}"

echo "==> Stopping workloads (PVC and Secret are preserved)..."
kubectl -n "$NAMESPACE" delete deployment web mongodb --ignore-not-found
kubectl -n "$NAMESPACE" delete service web mongodb --ignore-not-found
kubectl -n "$NAMESPACE" delete configmap app-config --ignore-not-found

if [ "${1:-}" = "--delete-cluster" ]; then
  echo "==> Deleting k3d cluster $CLUSTER..."
  k3d cluster delete "$CLUSTER"
else
  echo "==> Workloads stopped; MongoDB PVC and Secret were kept."
  echo "    To delete every local Kubernetes resource: k3d cluster delete $CLUSTER"
fi
