#!/usr/bin/env bash
set -euo pipefail

# 1-command startup for k3d Kubernetes (k3d-only, no minikube)
# Equivalent to `docker compose up --build` but for k8s:
#   builds image -> creates k3d cluster if missing -> imports image -> creates secret -> applies manifests
#
# Usage: bin/k8s-up [overlay]
#   overlay: base (default) | cache | search | full | edge
#     base   = web + mongodb            (app as-is, no cache/search)
#     cache  = + redis                  (CACHE_ENABLED=true)
#     search = + meilisearch            (SEARCH_ENABLED=true)
#     full   = + redis + meilisearch    (both enabled)
#     edge   = full + HAProxy TLS edge -> Service/web -> Rails x3

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PATH="$HOME/.local/bin:$PATH"

OVERLAY="${1:-base}"
CLUSTER="${K3D_CLUSTER:-dev}"
IMAGE="${K8S_IMAGE:-software_arch_team_4:k8s}"
NAMESPACE="software-arch-team4"

case "$OVERLAY" in
  base|cache|search|full|edge) ;;
  *) echo "error: unknown overlay '$OVERLAY' (use: base|cache|search|full|edge)"; exit 1 ;;
esac

if [ "$OVERLAY" = "base" ]; then
  KUSTOMIZE_DIR="$ROOT/k8s/base"
else
  KUSTOMIZE_DIR="$ROOT/k8s/overlays/$OVERLAY"
fi

[ -d "$KUSTOMIZE_DIR" ] || {
  echo "error: kustomize dir not found: $KUSTOMIZE_DIR"
  exit 1
}

echo "==> Checking prerequisites (docker, kubectl, k3d)..."
command -v docker >/dev/null 2>&1 || { echo "error: docker not found"; exit 1; }
command -v kubectl >/dev/null 2>&1 || { echo "error: kubectl not found (install: https://kubernetes.io/docs/tasks/tools/)"; exit 1; }
command -v k3d >/dev/null 2>&1 || { echo "error: k3d not found (curl -s https://raw.githubusercontent.com/k3d-io/k3d/main/install.sh | bash)"; exit 1; }

echo "==> Building image $IMAGE from Dockerfile.dev..."
docker build -f "$ROOT/Dockerfile.dev" -t "$IMAGE" "$ROOT"

if ! k3d cluster list 2>/dev/null | grep -qE "(^|[[:space:]])$CLUSTER([[:space:]]|$)"; then
  echo "==> Creating k3d cluster $CLUSTER..."
  k3d cluster create "$CLUSTER" --port "30080:80@loadbalancer" --port "30443:443@loadbalancer"
else
  echo "==> Cluster $CLUSTER already exists, reusing..."
fi

echo "==> Importing image $IMAGE into k3d cluster $CLUSTER..."
k3d image import "$IMAGE" -c "$CLUSTER"

echo "==> Ensuring namespace $NAMESPACE..."
kubectl apply -f "$ROOT/k8s/base/namespace.yaml" >/dev/null

# Create secret if missing (do not overwrite real one with dummy template)
if ! kubectl -n "$NAMESPACE" get secret app-secret >/dev/null 2>&1; then
  echo "==> Creating secret app-secret (SECRET_KEY_BASE + HARDCOVER_API_TOKEN)..."
  HARDCOVER_TOKEN="$(grep -h HARDCOVER_API_TOKEN "$ROOT/.env" 2>/dev/null | cut -d= -f2- | tr -d '\"' | tr -d "'" || true)"
  if [ -z "$HARDCOVER_TOKEN" ]; then
    HARDCOVER_TOKEN="dummy_hardcover_token_for_k8s_test"
  fi
  SECRET_BASE="$(openssl rand -hex 64)"
  kubectl -n "$NAMESPACE" create secret generic app-secret \
    --from-literal=HARDCOVER_API_TOKEN="$HARDCOVER_TOKEN" \
    --from-literal=SECRET_KEY_BASE="$SECRET_BASE"
else
  echo "==> Secret app-secret already exists, skipping creation (delete it first to regenerate)"
fi

if [ "$OVERLAY" = "edge" ] && ! kubectl -n "$NAMESPACE" get secret haproxy-tls >/dev/null 2>&1; then
  echo "==> Creating local-development TLS secret for HAProxy..."
  kubectl -n "$NAMESPACE" create secret generic haproxy-tls \
    --from-file=self-signed.pem="$ROOT/haproxy/certs/self-signed.pem"
fi

echo "==> Applying manifests (kustomize, overlay=$OVERLAY)..."
kubectl apply -k "$KUSTOMIZE_DIR"

echo "==> Waiting for deployments..."
kubectl -n "$NAMESPACE" wait --for=condition=available deployment/mongodb --timeout=120s
kubectl -n "$NAMESPACE" wait --for=condition=available deployment/web --timeout=120s
# Extra services may exist depending on overlay (redis / meilisearch)
for dep in redis meilisearch haproxy; do
  if kubectl -n "$NAMESPACE" get deployment "$dep" >/dev/null 2>&1; then
    echo "==> Waiting for deployment/$dep..."
    kubectl -n "$NAMESPACE" wait --for=condition=available "deployment/$dep" --timeout=120s
  fi
done

if [ -z "${K8S_SKIP_SEED:-}" ]; then
  echo "==> Seeding data (runs reindex + cache clear automatically if enabled)..."
  kubectl -n "$NAMESPACE" exec deploy/web -- bin/rails db:seed || echo "!! seed failed (non-fatal)"
fi

echo ""
echo "==> Ready! k8s stack is up (k3d-only, overlay=$OVERLAY)."
kubectl -n "$NAMESPACE" get pods,svc,pvc
echo ""
echo "Access app via:"
if [ "$OVERLAY" = "edge" ]; then
  echo "  kubectl -n $NAMESPACE port-forward svc/haproxy 8080:80 8443:443"
  echo "  curl -H 'Host: app.localhost' http://localhost:8080/up   # expect 200"
else
  echo "  kubectl -n $NAMESPACE port-forward svc/web 3000:80"
  echo "  curl http://localhost:3000/up   # expect 200"
fi
echo ""
echo "Rancher: k3d kubeconfig get $CLUSTER -> Import Existing Cluster in Rancher UI -> see namespace $NAMESPACE"
echo ""
echo "To change variant (after bin/k8s-down): bin/k8s-up [base|cache|search|full|edge]"
