HARDCOVER_API_TOKEN=
CACHE_ENABLED=false
REDIS_URL=redis://redis:6379/0
SEARCH_ENABLED=false
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_API_KEY=dev-master-key
# Directory where uploaded book covers / author images are stored. Must be a
# shared, writable path in multi-instance deployments.
IMAGE_STORAGE_PATH=/data/images
# Rails is the origin on cache misses, including when HAProxy caches assets.
SERVE_STATIC=true
# Required by docker-compose.scale.yml; generate once with openssl rand -hex 64.
# Keep the same value across replicas and restarts. Do not commit the real value.
SECRET_KEY_BASE=
