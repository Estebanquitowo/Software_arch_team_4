HARDCOVER_API_TOKEN=
CACHE_ENABLED=false
REDIS_URL=redis://redis:6379/0
SEARCH_ENABLED=false
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_API_KEY=dev-master-key
# Directory where uploaded book covers / author images are stored. Must be a
# shared, writable path in multi-instance deployments.
IMAGE_STORAGE_PATH=/data/images
# Set to false when a reverse proxy (HAProxy) handles static assets at the
# edge. The app stops serving public/ files and /images/* uploads.
SERVE_STATIC=true
