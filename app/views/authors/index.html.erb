<% content_for :title, "Authors" %>

<div class="flex justify-between items-center mb-6">
  <div>
    <h1 class="page-heading mb-0">Authors</h1>
    <p class="text-xs text-gray-500 mt-1">Showing page <%= @page %> of <%= @total_pages %> (<%= @total %> total authors)</p>
  </div>
  <%= link_to "New Author", new_author_path, class: "btn-primary" %>
</div>

<% if notice.present? %>
  <div class="alert-notice">
    <%= notice %>
  </div>
<% end %>

<div class="table-container">
  <table class="table-base">
    <thead>
      <tr>
        <th class="th-cell">Name</th>
        <th class="th-cell">Date of Birth</th>
        <th class="th-cell">Country</th>
        <th class="th-cell">Description</th>
        <th class="th-cell">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @authors.each do |author| %>
        <tr class="hover:bg-gray-50 transition-colors">
          <td class="td-cell font-medium text-gray-900">
            <%= link_to author.name, author, class: "text-blue-600 hover:underline" %>
          </td>
          <td class="td-cell">
            <%= author.date_of_birth || "N/A" %>
          </td>
          <td class="td-cell">
            <%= author.country_of_origin || "N/A" %>
          </td>
          <td class="td-cell">
            <%= truncate(author.short_description, length: 80) %>
          </td>
          <td class="td-cell text-right space-x-2 whitespace-nowrap">
            <%= link_to "Show", author, class: "btn-link" %>
            <%= link_to "Edit", edit_author_path(author), class: "btn-link" %>
            <%= link_to "Delete", author, class: "btn-danger", data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<!-- Pagination -->
<%= render "shared/pagination", page: @page, total_pages: @total_pages %>
