<% content_for :title, "Database check" %>

<main data-controller="database-check" data-database-check-authors-url-value="<%= authors_path(format: :json) %>">
  <h1>Database check</h1>

  <p data-database-check-target="status">Loading data...</p>

  <section data-database-check-target="results" hidden>
    <p>Authors: <span data-database-check-target="authorCount">0</span></p>
    <p>Books: <span data-database-check-target="bookCount">0</span></p>

    <hr>

    <div data-database-check-target="authors"></div>
  </section>
</main>
