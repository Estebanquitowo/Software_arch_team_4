<% content_for :title, @author.name %>

<% if notice.present? %>
  <div class="alert-notice max-w-2xl">
    <%= notice %>
  </div>
<% end %>

<div class="mb-6">
  <%= render @author %>
</div>

<div class="flex items-center space-x-4">
  <%= link_to "Edit this author", edit_author_path(@author), class: "btn-primary" %>
  <%= link_to "Back to authors", authors_path, class: "btn-link" %>
  <%= button_to "Destroy this author", @author, method: :delete, class: "btn-danger", data: { turbo_confirm: "Are you sure?" } %>
</div>
