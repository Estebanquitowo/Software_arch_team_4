<div id="<%= dom_id author %>" class="card max-w-2xl">
  <div class="space-y-4">
    <div>
      <span class="field-label">Name</span>
      <p class="text-lg font-medium text-gray-900"><%= author.name %></p>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <span class="field-label">Date of Birth</span>
        <p class="text-sm text-gray-800"><%= author.date_of_birth || "N/A" %></p>
      </div>
      <div>
        <span class="field-label">Country of Origin</span>
        <p class="text-sm text-gray-800"><%= author.country_of_origin || "N/A" %></p>
      </div>
    </div>

    <div>
      <span class="field-label">Short Description</span>
      <p class="text-sm text-gray-700 leading-relaxed"><%= author.short_description.presence || "No description provided." %></p>
    </div>
  </div>
</div>