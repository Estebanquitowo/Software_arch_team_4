<%= form_with(model: author, class: "space-y-4 max-w-lg", multipart: true) do |form| %>
  <% if author.errors.any? %>
    <div class="alert-error">
      <h2 class="font-semibold mb-2">
        <%= pluralize(author.errors.count, "error") %> prohibited this author from being saved:
      </h2>
      <ul class="list-disc list-inside space-y-1">
        <% author.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-input" %>
  </div>

  <div>
    <%= form.label :image, "Profile Image", class: "form-label" %>
    <% if author.image.present? %>
      <div class="mb-2">
        <%= image_tag stored_image_path(author.image), class: "w-24 rounded border border-gray-200", alt: "#{author.name} photo" %>
      </div>
    <% end %>
    <%= form.file_field :image, accept: "image/jpeg,image/png,image/gif,image/webp", class: "form-input" %>
    <% if author.image.present? %>
      <label class="mt-1 inline-flex items-center text-sm text-gray-600">
        <%= form.check_box :remove_image, class: "mr-1" %> Remove current image
      </label>
    <% end %>
  </div>

  <div>
    <%= form.label :date_of_birth, class: "form-label" %>
    <%= form.date_field :date_of_birth, class: "form-input" %>
  </div>

  <div>
    <%= form.label :country_of_origin, class: "form-label" %>
    <%= form.text_field :country_of_origin, class: "form-input" %>
  </div>

  <div>
    <%= form.label :short_description, class: "form-label" %>
    <%= form.textarea :short_description, rows: 4, class: "form-input" %>
  </div>

  <div>
    <%= form.submit class: "btn-primary" %>
  </div>
<% end %>
