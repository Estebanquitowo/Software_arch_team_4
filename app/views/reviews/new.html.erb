<% content_for :title, "New review" %>

<div class="mb-4">
  <%= link_to @book, class: "btn-back" do %>
    <span class="mr-1">&larr;</span> Back to <%= @book.title %>
  <% end %>
</div>

<h1 class="page-heading">New Review for <%= @book.title %></h1>

<%= render "form", book: @book, review: @review %>

<div class="mt-6">
  <%= link_to "Back to book", @book, class: "btn-link" %>
</div>
