<div id="<%= dom_id book %>" class="card max-w-3xl">
  <div class="space-y-4">
    
    <% if book.cover_image.present? %>
      <div>
        <%= image_tag stored_image_path(book.cover_image), class: "w-32 rounded border border-gray-200", alt: "#{book.title} cover" %>
      </div>
    <% end %>

    <div>
      <span class="field-label">Title</span>
      <h2 class="text-xl font-bold text-gray-900"><%= book.title %></h2>
    </div>

    <div>
      <span class="field-label">Summary</span>
      <p class="text-sm text-gray-700 leading-relaxed"><%= book.summary.presence || "No summary provided." %></p>
    </div>

    <%# Smaller Attributes %>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <span class="field-label">Author</span>
        <p class="text-sm font-medium text-gray-900">
          <%= book.author ? link_to(book.author.name, book.author, class: "text-blue-600 hover:underline") : "Unknown" %>
        </p>
      </div>

      <div>
        <span class="field-label">Publication</span>
        <p class="text-sm text-gray-800">
          <%= book.publication_date || book.publication_year || "N/A" %>
        </p>
      </div>

      <div>
        <span class="field-label">Avg Rating</span>
        <p class="text-sm text-gray-800">
          <% average_score = book.average_review_score %>
          <% if average_score.present? %>
            <span class="font-semibold text-amber-700">
              ★ <%= sprintf('%.2f', average_score) %> / 5
            </span>
          <% else %>  
            <span class="text-gray-400 text-xs italic">Unrated</span>
          <% end %>
        </p>
      </div>

      <div>
        <span class="field-label">Total Sales</span>
        <p class="text-sm font-medium text-gray-800">
          <%= number_with_delimiter(book.number_of_sales || 0) %> units
        </p>
      </div>
    </div>

  </div>
</div>
