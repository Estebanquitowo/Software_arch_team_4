<% content_for :title, "Sale Record (#{@sale.year}) - #{@book.title}" %>

<!-- Top Back Link -->
<div class="mb-4">
  <%= link_to @book, class: "btn-back" do %>
    <span class="mr-1">&larr;</span> Back to <%= @book.title %>
  <% end %>
</div>

<% if notice.present? %>
  <div class="alert-notice max-w-2xl">
    <%= notice %>
  </div>
<% end %>

<div class="card max-w-2xl mb-6">
  <div class="space-y-4">
    <div>
      <span class="field-label">
        Sales Year
      </span>
      <h2 class="text-xl font-bold text-gray-900">
        <%= @sale.year %>
      </h2>
    </div>

    <div class="grid grid-cols-2 gap-4 pt-2 border-t border-gray-100">
      <div>
        <span class="field-label">
          Units Sold
        </span>
        <p class="text-sm font-medium text-gray-900">
          <%= number_with_delimiter(@sale.units_sold) %> units
        </p>
      </div>
      <div>
        <span class="field-label">
          Total Revenue
        </span>
        <p class="text-sm font-medium text-gray-900">
          <%= number_to_currency(@sale.revenue, precision: 0) rescue "$#{@sale.revenue}" %>
        </p>
      </div>
    </div>

    <div class="pt-2 border-t border-gray-100">
      <span class="field-label">
        Book
      </span>
      <p class="text-sm text-gray-900">
        <%= link_to @book.title, @book, class: "text-blue-600 hover:underline" %>
      </p>
    </div>
  </div>
</div>

<div class="flex items-center space-x-4 max-w-2xl">
  <%= link_to "Edit this record", edit_book_sale_path(@book, @sale), class: "btn-primary" %>
  <%= link_to "Back to book", @book, class: "btn-link" %>
  <%= button_to "Destroy this record", book_sale_path(@book, @sale), method: :delete, class: "btn-danger", data: { turbo_confirm: "Are you sure you want to delete this sale record?" } %>
</div>
